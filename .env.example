# =============================================================================
# SAHYOG — Production Supabase & Authentication Configuration
# =============================================================================

# 1. Supabase Project Configuration
# Obtain these from your Supabase Dashboard: Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 2. Supabase Phone Auth & SMS Provider Notes
# In Supabase Dashboard -> Authentication -> Providers -> Phone:
# - Enable Phone provider
# - Select SMS Provider (Twilio, MessageBird, Vonage, or Fast2SMS / Textlocal via Webhook)
# - For Indian mobile numbers, SAHYOG automatically formats inputs to E.164 (+91XXXXXXXXXX)
# - For local/staging development without SMS credits, configure Supabase Test Phone Numbers
#   (e.g., +919980122334 with OTP 123456).

# 3. Optional Backend Microservice / API Base URL
VITE_API_BASE_URL=http://localhost:8000


