# =============================================================================
# SAHYOG / Aidora — Environment Configuration Template
# =============================================================================
#
# QUICK START GUIDE:
# - For LOCAL DEVELOPMENT with free Phone OTP:
#   Copy this file to `.env.local` and use the LOCAL DEVELOPMENT settings below.
# - For PRODUCTION (Vercel / Cloud):
#   Set these environment variables in your Vercel Project Settings -> Environment Variables.
# =============================================================================

# -----------------------------------------------------------------------------
# OPTION A: PRODUCTION / STAGING (Supabase Cloud + Real SMS OTP)
# -----------------------------------------------------------------------------
# Obtain from your Supabase Cloud Dashboard: Project Settings -> API
# VITE_SUPABASE_URL=https://your-project-id.supabase.co
# VITE_SUPABASE_ANON_KEY=your-actual-production-anon-key

# -----------------------------------------------------------------------------
# OPTION B: LOCAL DEVELOPMENT (Supabase CLI + Free Test OTP)
# -----------------------------------------------------------------------------
# When running Supabase locally via `npx supabase start`, use these local defaults:
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJpYXQiOjE2NDkyOTk4MDAsImV4cCI6MjAwNDg3NTgwMH0.xxx

# -----------------------------------------------------------------------------
# LOCAL TEST CREDENTIALS (Configured in supabase/config.toml)
# -----------------------------------------------------------------------------
# Customer Test Phone: +919876543210  -> Fixed OTP: 123456
# Worker Test Phone:   +919876543211  -> Fixed OTP: 654321
#
# Note: These test OTPs work only against the local Supabase instance.
# Production Vercel deployments do NOT have test OTP enabled and require real SMS.
# -----------------------------------------------------------------------------

# Optional: Backend Microservice / API Base URL
VITE_API_BASE_URL=http://localhost:8000
