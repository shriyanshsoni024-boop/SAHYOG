# SAHYOG — Production Supabase Configuration
# Replace with your actual Supabase project URL and public Anon key.
# In development without Supabase, the application gracefully operates in local persistent mode.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# SAHYOG — Dedicated Authentication & Backend API Base URL
# If provided, the frontend will dispatch real HTTP requests to this backend.
# If omitted or offline, the frontend uses the secure client mock adapter with hashed credentials.
VITE_API_BASE_URL=http://localhost:8000

